---
import Layout from "@/layouts/Layout.astro";
import { setup } from "@/data/setup";

const linkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline ml-1 opacity-40"><path d="M10 14a4 4 0 0 0 5.66 0l3-3A4 4 0 0 0 13 5.34l-1.5 1.5"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3A4 4 0 0 0 11 18.66l1.5-1.5"/></svg>`;
---

<Layout title="setup" description="hardware and software i use daily">
  <section class="pt-16">
    <h1 class="text-3xl font-medium mb-2 font-display">setup</h1>
    <p class="text-muted text-sm mb-12">hardware and software i use daily.</p>

    <div class="space-y-10">
      {
        setup.map((category) => (
          <div>
            <h2 class="text-xs font-medium mb-4 text-muted/70 uppercase tracking-widest">
              {category.title}
            </h2>
            <ul class="space-y-3">
              {category.items.map((item) => (
                <li class="flex items-baseline justify-between gap-4">
                  <div>
                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-foreground hover:text-accent-hover transition-colors"
                      >
                        {item.name}
                        <Fragment set:html={linkIcon} />
                        <span class="sr-only">(opens in new tab)</span>
                      </a>
                    ) : (
                      <span class="text-foreground">{item.name}</span>
                    )}
                  </div>
                  {item.description && (
                    <span class="text-muted text-sm">{item.description}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <a
      href="/"
      class="text-muted block mt-16 underline hover:text-foreground transition-colors"
      >back to home</a
    >
  </section>
</Layout>
