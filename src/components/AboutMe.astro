---
import HoverImage from "./HoverImage";

const interests = [
  { text: "technology", image: "/interests/technology.jpg" },
  { text: "memes", image: "/interests/memes.jpg" },
  { text: "sports", image: "/interests/sports.jpg" },
  { text: "video games", image: "/interests/videogames.jpg" },
  { text: "music", image: "/interests/music.jpg" },
];
---

<section class="max-w-4xl space-y-6">
  <p class="leading-relaxed">
    third-year cs student at bbu, looking to work with people who build things
    that matter.
  </p>

  <p class="leading-relaxed">
    i work mostly with react, tailwindcss, motion, and typescript.
  </p>

  <p class="leading-relaxed">
    started programming to take things apart and understand how they fit
    together—that curiosity still drives everything i build.
  </p>

  <p class="leading-relaxed text-muted">
    i like{" "}<span
      class="inline sm:inline-flex sm:flex-wrap sm:items-baseline"
      >{
        interests.map((item, index) => (
          <>
            <HoverImage
              client:load
              text={item.text}
              imageSrc={item.image}
              imageAlt={item.text}
            />
            <span class="hidden sm:inline">
              {index < interests.length - 2
                ? ","
                : index === interests.length - 2
                  ? ", and"
                  : "."}
            </span>
            <span class="sm:hidden -ml-1">
              {index < interests.length - 2
                ? ", "
                : index === interests.length - 2
                  ? ", and "
                  : "."}
            </span>
            {index < interests.length - 1 && (
              <span class="hidden sm:inline">&nbsp;</span>
            )}
          </>
        ))
      }</span
    >
  </p>

  <nav class="flex flex-wrap items-center gap-3 text-sm" aria-label="Site navigation">
    <a href="/projects/" class="text-foreground underline hover:text-accent-hover transition-colors duration-200 ease">projects</a>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">//</span>
    <a href="/setup/" class="text-foreground underline hover:text-accent-hover transition-colors duration-200 ease">setup</a>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">//</span>
    <a href="/credits/" class="text-foreground underline hover:text-accent-hover transition-colors duration-200 ease">credits</a>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">//</span>
    <a href="https://github.com/vasiledraguta/draguta.dev" target="_blank" rel="noopener noreferrer" class="text-foreground underline hover:text-accent-hover transition-colors duration-200 ease">source<span class="sr-only"> (opens in new tab)</span></a>
  </nav>
</section>
