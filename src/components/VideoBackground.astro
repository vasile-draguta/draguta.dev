<div
  id="video-container"
  class="fixed inset-0 -z-10 overflow-hidden transition-opacity duration-500"
  transition:persist
>
  <video
    id="bg-video"
    class="h-full w-full object-cover transition-opacity duration-500"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/background.webm" type="video/webm" />
  </video>
  <div id="video-scrim" class="absolute inset-0 transition-colors duration-500">
  </div>
</div>
